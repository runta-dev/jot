JOT_DRAFT_URL=http://127.0.0.1:8081/v1/chat/completions

# Default: local headed Google Chrome + shared profile.
# JOT_BROWSER_HEADLESS=1
# Optional Linux VM Chromium: npm run chrome:linux -- up
# JOT_BROWSER_CDP=1
